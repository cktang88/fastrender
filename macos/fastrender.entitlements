<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for a signed `fastrender` (hardened runtime): JavaScriptCore's JIT needs MAP_JIT memory, which the
     hardened runtime only grants with allow-jit. Without it JavaScriptCore falls back to its interpreter.
     codesign -f -s - -o runtime -e macos/fastrender.entitlements target/release/fastrender
     (docs/research/jsc-vs-v8.md) -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
