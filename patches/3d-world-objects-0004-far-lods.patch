+// ---------------------------------------------------------------- distant LOD (simplified at load)
+
+let simplifierOk = false;
+simplifierReady.then(() => (simplifierOk = true)).catch(() => {});
+/** the distant LOD: at most this share of the far LOD's triangles, within this error (m) */
+export const FLEET_DISTANT = { ratio: 0.12, error: 0.07, minTris: 96 };
+const distantCache = new Map<string, THREE.BufferGeometry | null>();
+/**
+ * The far LOD of a model simplified once more for cars beyond FLEET_LOD.FAR, where a car is a few dozen pixels
+ * long and the far LOD's 1.5-2.8k triangles are several per pixel (at 90 m and a 70 degree field of view a pixel
+ * of a 1600 px high drawable is 8 cm). Same attributes and materials as merged(p, 2, paint), so no new shader.
+ * The far LOD is a set of open patches with their seams doubled (hard edges), which stops edge collapse at
+ * ~65 %: vertices at the same place with the same colour are welded first (each keeps one of its normals, good
+ * enough at this size), then edge collapse within FLEET_DISTANT.error keeps the silhouette and the colour
+ * borders; where that still leaves too much, the topology-free simplifier takes over. undefined until the
+ * simplifier's wasm is ready, null when the far LOD is already small or nothing is gained.
+ */
+function distant(p: Prepared, paint: boolean): THREE.BufferGeometry | null | undefined {
+  const key = `${p.id}|${paint}`;
+  if (distantCache.has(key)) return distantCache.get(key)!;
+  if (!simplifierOk) return undefined;
+  let out: THREE.BufferGeometry | null = null;
+  const src = merged(p, 2, paint);
+  try {
+    const tris = src?.index ? src.index.count / 3 : 0;
+    if (src && tris >= FLEET_DISTANT.minTris * 2) {
+      const f32 = (name: string) => {
+        const a = src.getAttribute(name) as THREE.BufferAttribute | undefined;
+        return a && a.array instanceof Float32Array && !a.normalized ? a : null;
