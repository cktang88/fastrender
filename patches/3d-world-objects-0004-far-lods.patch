diff --git a/src/nyc/chunkLod.ts b/src/nyc/chunkLod.ts
new file mode 100644
index 0000000..fdc42f8
--- /dev/null
+++ b/src/nyc/chunkLod.ts
@@ -0,0 +1,228 @@
+import * as THREE from 'three';
+import { simplifierReady, simplifyMesh, compact, remapAttribute } from '../meshlod-core';
+
+/**
+ * Far LODs of a street block's merged static meshes.
+ *
+ * bake() (common.ts) merges a block's static parts into a few meshes per material, up to ~33k triangles each
+ * and ~140k per block. A block is drawn whole whenever any of it is in view, so the blocks down an avenue cost
+ * as many triangles at 150 m as the one the player stands in: about a million triangles per frame in the
+ * street view, most of them where one of those triangles is well under a pixel.
+ *
+ * Here every merged mesh above CHUNK_LOD.minTris gets a coarse twin per level: the same material, vertex
+ * colours, uvs and bounds, simplified with meshoptimizer (meshlod-core) to a geometric error of at most `error`
+ * metres with normals, uv seams and colour borders weighed in, compacted to the vertices it uses (about a third
+ * of the triangles at 6 cm). A block whose nearest point is farther than a level's `dist` shows that level's
+ * twins (setChunkLevel), a nearer one the originals. The error is about one pixel of a 1600 px high drawable at
+ * the distance where the level starts (70 degree field of view: 6 cm at 70 m), so a twin is within a pixel of
+ * the original from where it is used. What that leaves out: parts thinner than the error (a 3 cm door sill, a
+ * thin rod) collapse to nothing.
+ * Shadows follow (a twin casts when the original did). The block's small details (`fine`, buildings.ts
+ * setBlockDetail) are not touched: they are only shown on the nearest blocks anyway.
+ *
+ * When: NycLevel.update builds the twins of a block the first time it is far enough to show them, in the frames
+ * where no block is being built, a few ms at a time; until then the block shows its originals. Blocks the
+ * player never leaves the neighbourhood of get none. Memory: a twin holds about a third of its original's vertices.
+ *
+ * Cost: the simplifier takes ~4 ms per 1000 triangles of input whatever the target (attribute quadrics over
+ * unwelded flat-shaded parts): ~0.4 s per block and level, in steps of CHUNK_LOD.stepTris triangles.
+ * That is why there is one level: a second one ({ dist: 35, back: 5, error: 0.03 }, ~55 % of the triangles for
+ * the blocks next to the player's) is measured to take another 100k triangles off the street view and doubles
+ * that time.
+ */
+export const CHUNK_LOD = {
+  /** switch for comparisons (labs, tests) */
+  on: true,
+  /**
+   * coarser levels after the originals: blocks whose nearest point is beyond `dist` (m) show twins within `error`
+   * (m) of the originals, and come back to the finer level inside dist - back
+   */
+  levels: [{ dist: 70, back: 8, error: 0.06 }],
+  /** triangles simplified per step (~4 ms per 1000 in V8) */
+  stepTris: 1500,
+  /** merged meshes under this many triangles keep one version */
+  minTris: 400,
+  /** a twin is kept when it has at most this share of the triangles of the level before it */
+  gain: 0.8,
+  /** totals so far (tools, tests): merged meshes with a twin, their triangles, the twins' triangles per level */
+  stats: { meshes: 0, tris: 0, lodTris: [0] },
+};
+
+// for tools that drive the game from outside (benchmarks: on = false shows the originals again)
+(globalThis as unknown as { __chunkLod: typeof CHUNK_LOD }).__chunkLod = CHUNK_LOD;
+
+let ok = false;
+simplifierReady.then(() => (ok = true)).catch(() => {});
+/** the simplifier's wasm has loaded and the LODs are on */
+export const chunkLodReady = () => ok && CHUNK_LOD.on;
+
+/** per merged mesh of a block: [original, twin of level 1, twin of level 2, ...] (null: the level before it serves) */
+export type ChunkLod = (THREE.Mesh | null)[][];
+
+type Attr = THREE.BufferAttribute & { isInterleavedBufferAttribute?: boolean };
+const f32 = (g: THREE.BufferGeometry, name: string, size: number) => {
+  const a = g.getAttribute(name) as Attr | undefined;
+  return a && a.array instanceof Float32Array && a.itemSize === size && !a.normalized && !a.isInterleavedBufferAttribute ? a : null;
+};
+
+/**
+ * Where a merged mesh can be cut into pieces that share no vertex: mergeGeometries appends part after part, so
+ * both the triangles and the vertices of a part are contiguous. Returns [first index, end index, first vertex,
+ * end vertex] per piece of about `tris` triangles (one piece when there is no such cut).
+ */
+function pieces(ix: Uint32Array, tris: number): [number, number, number, number][] {
+  const n = ix.length / 3;
+  // lowest vertex used from triangle t on
+  const low = new Uint32Array(n + 1);
+  low[n] = 0xffffffff;
+  for (let t = n - 1; t >= 0; t--) low[t] = Math.min(low[t + 1], ix[t * 3], ix[t * 3 + 1], ix[t * 3 + 2]);
+  const out: [number, number, number, number][] = [];
+  let start = 0, high = -1;
+  for (let t = 0; t < n; t++) {
+    high = Math.max(high, ix[t * 3], ix[t * 3 + 1], ix[t * 3 + 2]);
+    // a cut after triangle t: nothing later uses a vertex up to `high`
+    if (t + 1 === n || (t + 1 - start >= tris && low[t + 1] > high)) {
+      out.push([start * 3, (t + 1) * 3, low[start], high + 1]);
+      start = t + 1;
+    }
+  }
+  return out;
+}
+
+/**
+ * `src` (the geometry of `mesh`) simplified within `error`; null when that gains too little. A step per piece
+ * of CHUNK_LOD.stepTris triangles: the simplifier's time goes with its input, and a merged mesh is thousands of
+ * separate parts, so simplifying it piece by piece gives the same result in steps of a few ms.
+ */
+function* twinSteps(mesh: THREE.Mesh, src: THREE.BufferGeometry, error: number): Generator<void, THREE.Mesh | null, void> {
+  const index = src.index;
+  if (!index || src.groups.length || Array.isArray(mesh.material)) return null;
+  const tris = index.count / 3;
+  if (tris < CHUNK_LOD.minTris) return null;
+  const P = f32(src, 'position', 3);
+  if (!P) return null;
+  const mat = mesh.material as THREE.MeshStandardMaterial;
+  if (mat.transparent || mat.alphaTest > 0) return null;
+  const N = f32(src, 'normal', 3), C = f32(src, 'color', 3) ?? f32(src, 'color', 4);
+  // uvs matter only where the material samples a texture with them (bake() gives every mesh a uv attribute)
+  const textured = !!(mat.map || mat.normalMap || mat.roughnessMap || mat.metalnessMap || mat.emissiveMap || mat.aoMap || mat.userData?.pbr);
+  const U = textured ? f32(src, 'uv', 2) : null;
+  const ix = index.array instanceof Uint32Array ? index.array : new Uint32Array(index.array as ArrayLike<number>);
+  const sub = (a: Attr | null, v0: number, v1: number) => (a ? (a.array as Float32Array).subarray(v0 * a.itemSize, v1 * a.itemSize) : null);
+  const done: Uint32Array[] = [];
+  let kept = 0, worst = 0;
+  for (const [i0, i1, v0, v1] of pieces(ix, CHUNK_LOD.stepTris)) {
+    const local = new Uint32Array(i1 - i0);
+    for (let i = i0; i < i1; i++) local[i - i0] = ix[i] - v0;
+    const r = simplifyMesh(
+      { index: local, position: sub(P, v0, v1)!, normal: sub(N, v0, v1), uv: sub(U, v0, v1), color: sub(C, v0, v1), colorSize: C?.itemSize },
+      { targetTris: 0, error, absolute: true, permissive: true, prune: true },
+    );
+    for (let i = 0; i < r.index.length; i++) r.index[i] += v0;
+    done.push(r.index);
+    kept += r.index.length;
+    worst = Math.max(worst, r.error);
+    yield;
+  }
+  const lodTris = kept / 3;
+  if (lodTris < 1 || lodTris > tris * CHUNK_LOD.gain) return null;
+  const all = new Uint32Array(kept);
+  let at = 0;
+  for (const d of done) {
+    all.set(d, at);
+    at += d.length;
+  }
+  const c = compact(all);
+  const lg = new THREE.BufferGeometry();
+  for (const [name, a] of Object.entries(src.attributes)) {
+    const b = a as Attr;
+    if (!(b.array instanceof Float32Array) || b.isInterleavedBufferAttribute) return null;
+    lg.setAttribute(name, new THREE.BufferAttribute(remapAttribute(b.array, b.itemSize, c.remap, c.count), b.itemSize, b.normalized));
+  }
+  lg.setIndex(new THREE.BufferAttribute(c.count > 65535 ? c.index : new Uint16Array(c.index), 1));
+  // the original's bounds: culled, shadow-tagged (lighting.ts casterR) and sorted exactly like it
+  const g = mesh.geometry;
+  if (!g.boundingSphere) g.computeBoundingSphere();
+  if (!g.boundingBox) g.computeBoundingBox();
+  lg.boundingSphere = g.boundingSphere!.clone();
+  lg.boundingBox = g.boundingBox!.clone();
+  const twin = new THREE.Mesh(lg, mesh.material);
+  twin.name = mesh.name;
+  twin.castShadow = mesh.castShadow;
+  twin.receiveShadow = mesh.receiveShadow;
+  twin.renderOrder = mesh.renderOrder;
+  twin.layers.mask = mesh.layers.mask;
+  twin.position.copy(mesh.position);
+  twin.quaternion.copy(mesh.quaternion);
+  twin.scale.copy(mesh.scale);
+  twin.userData.owned = true;
+  twin.userData.baked = true;
+  twin.userData.chunkLod = { tris: lodTris, error: worst };
+  twin.visible = false;
+  return twin;
+}
+
+/**
+ * Build the twins of a block's merged meshes into `out`, in steps of a few ms (twinSteps). The twins are added
+ * next to their originals, hidden; setChunkLevel shows them.
+ */
+export function* chunkLodSteps(group: THREE.Object3D, out: ChunkLod): Generator<void, void, void> {
+  const todo: THREE.Mesh[] = [];
+  const visit = (o: THREE.Object3D) => {
+    if (o.userData.fine) return; // small details: hidden beyond the nearest blocks (setBlockDetail)
+    const m = o as THREE.Mesh;
+    if (m.isMesh && m.userData.baked && !m.userData.chunkLod && !(m as unknown as THREE.InstancedMesh).isInstancedMesh && m.parent) todo.push(m);
+    for (const c of o.children) visit(c);
+  };
+  visit(group);
+  const st = CHUNK_LOD.stats;
+  for (const mesh of todo) {
+    if (group.userData.disposed) return;
+    const entry: (THREE.Mesh | null)[] = [mesh];
+    let any = false;
+    try {
+      // each level from the original, so its error is the whole budget (from the level before it the errors add
+      // up and a third more triangles are left); kept only when it gains on the level before it
+      let prev = mesh.geometry.index ? mesh.geometry.index.count / 3 : 0;
+      for (const [i, level] of CHUNK_LOD.levels.entries()) {
+        let twin = yield* twinSteps(mesh, mesh.geometry, level.error);
+        if (twin && twin.geometry.index!.count / 3 > prev * CHUNK_LOD.gain) {
+          twin.geometry.dispose();
+          twin = null;
+        }
+        entry.push(twin);
+        if (!twin) continue;
+        any = true;
+        prev = twin.geometry.index!.count / 3;
+        st.lodTris[i] = (st.lodTris[i] ?? 0) + prev;
+        mesh.parent!.add(twin);
+      }
+    } catch {
+      // (a twin already added stays: the entry lists it)
+    }
+    if (!any) continue;
+    while (entry.length <= CHUNK_LOD.levels.length) entry.push(null);
+    st.meshes++;
+    st.tris += mesh.geometry.index!.count / 3;
+    out.push(entry);
+  }
+}
+
+/** show a block's merged meshes at a level: 0 the originals, n the twins of CHUNK_LOD.levels[n - 1] */
+export function setChunkLevel(lod: ChunkLod, level: number) {
+  for (const entry of lod) {
+    let show = Math.min(level, entry.length - 1);
+    while (show > 0 && !entry[show]) show--;
+    for (let i = 0; i < entry.length; i++) {
+      const m = entry[i];
+      if (m) m.visible = i === show;
+    }
+  }
+}
+
+/** the level of a block whose nearest point is `d` metres away and that shows level `cur` now */
+export function chunkLevel(d: number, cur: number) {
+  let level = 0;
+  if (CHUNK_LOD.on) for (const [i, l] of CHUNK_LOD.levels.entries()) if (d > l.dist - (cur > i ? l.back : 0)) level = i + 1;
+  return level;
+}
