+/**
+ * Far LODs of a block's merged meshes (src/nyc/chunkLod.ts): the twins exist, are much smaller, stay within their
+ * error of the originals in both directions, keep material / attributes / bounds / shadow flags, and exactly one
+ * version of each merged mesh is shown per level.
+ */
+import * as THREE from 'three';
+import { test, expect, between, fmt } from './qa';
+import { nycChunk } from './world';
+import { simplifierReady, surfaceDistance } from '../src/meshlod-core';
+import { CHUNK_LOD, chunkLodSteps, chunkLevel, setChunkLevel, type ChunkLod } from '../src/nyc/chunkLod';
+import { FLEET_LOD } from '../src/nyc/vehicleFleet';
+
+const tris = (m: THREE.Mesh) => m.geometry.index!.count / 3;
+const arrays = (m: THREE.Mesh) => {
+  const ix = m.geometry.index!.array;
+  return { p: m.geometry.getAttribute('position').array as Float32Array, i: ix instanceof Uint32Array ? ix : new Uint32Array(ix) };
+};
+
+let built: ChunkLod | null = null;
+async function lodOf() {
+  if (built) return built;
+  await simplifierReady;
+  const c = nycChunk(1, 0, 0);
+  const lod: ChunkLod = [];
+  let steps = 0, longest = 0;
+  const t0 = performance.now();
+  let t = t0;
+  for (const _ of chunkLodSteps(c.group, lod)) {
+    steps++;
+    longest = Math.max(longest, performance.now() - t);
+    t = performance.now();
+  }
+  const full = lod.reduce((n, e) => n + tris(e[0]!), 0);
+  console.log(`far LODs of one block: ${lod.length} merged meshes (${full} triangles) in ${fmt(performance.now() - t0)} ms, ${steps} steps, longest ${fmt(longest)} ms`);
+  expect(steps >= full / CHUNK_LOD.stepTris / 4, `${steps} steps for ${full} triangles: the merged meshes are not cut into pieces`);
+  expect(steps >= lod.length, `${steps} steps for ${lod.length} merged meshes`);
+  // a second pass finds nothing new (twins are not originals)
+  const again: ChunkLod = [];
+  for (const _ of chunkLodSteps(c.group, again)) void _;
+  expect(again.length === lod.length, `a second pass lists the same ${lod.length} originals, not their twins (${again.length})`);
+  for (const e of again) for (const t of e.slice(1)) if (t) { t.parent?.remove(t); t.geometry.dispose(); }
+  return (built = lod);
+}
+
+test('a block gets coarse twins of its merged meshes: the far level has under 45 % of their triangles', async () => {
+  const lod = await lodOf();
+  expect(lod.length >= 5, `${lod.length} merged meshes with a twin`);
+  let full = 0;
+  const level = CHUNK_LOD.levels.map(() => 0);
+  for (const e of lod) {
+    expect(e.length === CHUNK_LOD.levels.length + 1, `entry has ${e.length} versions`);
+    full += tris(e[0]!);
+    let shown = e[0]!;
+    for (let i = 1; i < e.length; i++) {
+      if (e[i]) {
+        expect(tris(e[i]!) <= tris(shown) * CHUNK_LOD.gain, `level ${i}: ${tris(e[i]!)} of ${tris(shown)} triangles is not worth a twin`);
+        shown = e[i]!;
+      }
